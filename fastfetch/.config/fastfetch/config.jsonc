{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "left": 2
        },
        "color": {
            "1": "38;2;0;0;0",
            "2": "38;2;94;94;94"
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "38;2;0;0;0",
            "title": "38;2;59;59;59"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "break",
        {
            "type": "os",
            "key": "  os",
            "format": "{pretty-name}"
        },
        {
            "type": "host",
            "key": "󰍹  host",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "  kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "  uptime"
        },
        {
            "type": "packages",
            "key": "  pkgs"
        },
        {
            "type": "shell",
            "key": "  shell",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": "  wm",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "  term",
            "format": "{pretty-name}"
        },
        {
            "type": "command",
            "key": "  cpu",
            "text": "awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo| sed -E 's/^[0-9]+th Gen //; s/Intel[(]R[)] Core[(]TM[)] /Intel Core /; s/ @.*//'"
        },
        {
            "type": "gpu",
            "key": "󰢮  gpu",
            "format": "{name:22}"
        },
        {
            "type": "memory",
            "key": "  mem",
            "format": "{used} / {total}"
        },
        {
            "type": "display",
            "key": "  res",
            "format": "{width}x{height}"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2
        }
    ]
}
